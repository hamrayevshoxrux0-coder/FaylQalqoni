    <string name="settings_title">Sozlamalar</string>
    <string name="settings_api_key_label">Google Safe Browsing API kaliti</string>
    <string name="settings_api_key_help">Bu kalit kiritilsa, havolalar Google\'ning millionlab ma\'lum firibgarlik/zararli sayt bazasi bo\'yicha ham tekshiriladi. Kiritilmasa, faqat lokal qoidalar bilan tekshiriladi.</string>
    <string name="settings_api_key_hint">API kalitni shu yerga joylashtiring</string>
    <string name="settings_save">Saqlash</string>
    <string name="settings_status_set">✅ API kalit saqlangan — Safe Browsing tekshiruvi faol</string>
    <string name="settings_status_missing">API kalit kiritilmagan — faqat lokal qoidalar ishlaydi</string>
    <string name="settings_how_title">API kalitni qanday olish mumkin?</string>
    <string name="settings_how_steps">1. console.cloud.google.com saytida bepul loyiha yarating.\n2. \"APIs & Services\" → \"Library\" bo\'limidan \"Safe Browsing API\"ni toping va yoqing.\n3. \"Credentials\" bo\'limidan yangi API kalit yarating.\n4. Yaratilgan kalitni yuqoridagi maydonga joylashtirib, \"Saqlash\"ni bosing.</string>
